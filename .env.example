# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to client - no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit (used by Next.js app and the AI reviewer agent)
LIVEKIT_URL=wss://host.docker.internal:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# -----------------------------------------------------------------------------
# AI Game Reviewer (feature 022) and each player's chat with it
# Azure is only needed if you run the `reviewer` docker service. The GCP values
# are read by the reviewer and by the app, whose review chat (the report page)
# calls Gemini with the same service account.
# -----------------------------------------------------------------------------

# Azure Speech-to-Text — Persian transcription
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=fa-IR

# Google Vertex AI (Gemini) — the reviewer's report and the review chat
GCP_PROJECT_ID=your-gcp-project-id
# Each prompt names its model (Gemini 4, and the judge's gemini-3.1-pro-preview),
# served from `global`.
GCP_LLM_LOCATION=global
# docker-compose.yml mounts secrets/vertex-sa.json here, into `reviewer` and `app`
# (under `npm run dev`, the file's path on your machine):
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-sa.json
# Questions each player may ask the reviewer about one game (default 30).
# REVIEW_CHAT_MAX_QUESTIONS=30

# Optional overrides
# DATA_DIR=/data/games   # read by the app as well (reports, records)
# PROMPTS_DIR=./prompts
# LIVEKIT_BOT_IDENTITY_PREFIX=reviewer-
# GAME_WATCHER_INTERVAL_MS=3000
# AUDIO_SAMPLE_RATE=16000
# SILENCE_RMS_THRESHOLD=250
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=500
# TRANSCRIPT_CORRECTION_ENABLED=true   # LLM proofreading pass after Azure STT (recommended for Persian)
# Assassin-phase discussion timer (configurable). Read by the Next.js app
# only; exposed with NEXT_PUBLIC_ so the client sees it:
# NEXT_PUBLIC_DISCUSSION_DURATION_SEC=120
